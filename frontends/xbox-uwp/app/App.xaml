<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ZeebxXbox.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ZeebxXbox"
    RequestedTheme="Dark">

    <!-- Sem `XamlControlsResources`: ele vem do pacote WinUI 2, e a única coisa que este
         aplicativo ganharia com ele são controles que já usamos na forma padrão. Uma
         dependência a menos no pacote, e o tema escuro é do `RequestedTheme` acima. -->

    <Application.Resources>
        <ResourceDictionary>
            <!-- A paleta. Os jogos do Zeebo são escuros e saturados; uma GUI clara ao lado
                 deles cansa a vista. Estes pincéis são os mesmos em toda tela. -->
            <SolidColorBrush x:Key="Fundo" Color="#0E1013" />
            <SolidColorBrush x:Key="FundoDoCartao" Color="#1A1E24" />
            <SolidColorBrush x:Key="FundoDoCartaoFocado" Color="#2B3646" />
            <SolidColorBrush x:Key="Acento" Color="#21C7A8" />
            <SolidColorBrush x:Key="TextoFraco" Color="#8A93A0" />

            <Style x:Key="Titulo" TargetType="TextBlock">
                <Setter Property="FontSize" Value="34" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="White" />
            </Style>
            <Style x:Key="Rotulo" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource TextoFraco}" />
            </Style>

            <!-- O cartão de jogo: o foco do controle tem de ser ÓBVIO numa TV. Os `Setter` do
                 estilo cuidam do estado parado; os realces são dos `VisualState`, aqui embaixo.

                 **Os dois grupos de estado não são enfeite.** Um `ControlTemplate` sem
                 `VisualStateManager.VisualStateGroups` não troca de estado nenhum: o cartão ficava
                 com a mesma cor com foco e sem ele — a `FundoDoCartaoFocado` estava declarada no
                 topo deste arquivo e não era usada por ninguém. Os nomes dos grupos são os que o
                 `Button` procura: `CommonStates` (o ponteiro) e `FocusStates` (o controle). -->
            <Style x:Key="CartaoDeJogo" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource FundoDoCartao}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Cartao"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  BorderBrush="{TemplateBinding BorderBrush}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Cartao.Background" Value="{StaticResource FundoDoCartaoFocado}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Cartao.Background" Value="{StaticResource FundoDoCartaoFocado}" />
                                                <Setter Target="Cartao.BorderBrush" Value="{StaticResource Acento}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Cartao.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="FocusStates">
                                        <VisualState x:Name="Focused">
                                            <VisualState.Setters>
                                                <Setter Target="Cartao.Background" Value="{StaticResource FundoDoCartaoFocado}" />
                                                <Setter Target="Cartao.BorderBrush" Value="{StaticResource Acento}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerFocused">
                                            <VisualState.Setters>
                                                <Setter Target="Cartao.BorderBrush" Value="{StaticResource Acento}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unfocused" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- A linha de baixo: o que cada botão do controle faz. É ela que faz a tela parecer
                 um menu de console, e não uma janela de PC — sem ela, quem pega o controle não
                 sabe que o A é que abre o jogo. Discreta de propósito: quem já sabe não lê. -->
            <Style x:Key="Tecla" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{StaticResource TextoFraco}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- O botão de console: maior que o padrão, porque o foco tem de ser visível a três
                 metros — a distância de uma TV.

                 **Sem `ControlTemplate` novo, de propósito.** O modelo do sistema já traz o realce
                 de foco; um modelo escrito à mão que esqueça os `FocusStates` foi exatamente o
                 defeito que o cartão de jogo teve de consertar (ver `CartaoDeJogo`). Só
                 propriedades aqui. -->
            <Style x:Key="BotaoDeConsole" TargetType="Button">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Padding" Value="22,12" />
                <Setter Property="MinWidth" Value="130" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{StaticResource FundoDoCartao}" />
                <Setter Property="Foreground" Value="White" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
