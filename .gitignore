# ROMs / conteúdo de jogos — nunca versionar
roms/

# Material de terceiros espelhado (docs Qualcomm/Zeebo, SDKs, dumps de firmware, clones)
docs/vendor/

# Build
build/
cmake-build-*/
*.o
*.a
*.so
*.dylib
*.dll
*.exe

# macOS / editores
.DS_Store
.idea/
.vscode/
*.swp

# Rust
/target/
# O cxx-qt-build escreve a configuração do servidor de linguagem QML com o caminho desta máquina.
.qmlls.ini

# Saídas de depuração do `run` (--dump-heap) e o framebuffer exportado
heap.bin
module.bin
*.bmp

# Servidores privados vivem em repositórios próprios, ao lado deste.
zeeboids-server/
OperaMini-Server/

# Material do console (firmware, configs, pacotes do sistema) fica fora do repositório.
vendor/

# Relatórios que o emulador escreve ao lado do executável, um por execução.
*.log
*.bmp
.nodeterm/project.json
ref z-wheel2.png

# Android: o Gradle e o `.so` copiado pelo `cargo-ndk` são saída de build, não fonte.
frontends/android/apk/.gradle/
frontends/android/apk/local.properties
frontends/android/apk/app/src/main/jniLibs/
frontends/android/apk/app/src/main/assets/licenses/
frontends/switch/saida/

# Xbox (UWP): tudo o que o `msbuild` escreve no meio das fontes. O `.nupkg` do C++/WinRT que o
# `compilar.ps1` desempacota, o XAML gerado, o pacote e o `.cso` que o `fxc` produz ficam fora. Os
# `*_h.h` soltos (`App_h.h`, `MainPage_h.h`, `XamlMetaDataProvider_h.h`) são do `midlrt`, e não
# fonte: eles renascem a cada build, ao lado dos `.idl` que os geram.
frontends/xbox-uwp/packages/
frontends/xbox-uwp/app/AppPackages/
frontends/xbox-uwp/app/Generated Files/
frontends/xbox-uwp/app/x64/
frontends/xbox-uwp/app/ZeebxXbox/
frontends/xbox-uwp/app/*.cso
frontends/xbox-uwp/app/*_h.h
*.vcxproj.user

# Xcode: estado local. O projeto em si (`project.pbxproj`) fica versionado.
xcuserdata/
*.xcuserstate
